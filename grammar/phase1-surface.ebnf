# Phil Phase 1 surface grammar — canonical concrete syntax, version 1
#
# This file is normative for Phase 1 concrete syntax.  Semantic acceptance is
# governed by the checked declaration/Core contracts; parsing never supplies
# authority, assumptions, evidence, identity, or realization choices.
#
# Notation is a deliberately small EBNF:
#   name       nonterminal reference
#   "text"     literal token
#   <CLASS>    lexical token class
#   a, b       sequence
#   a | b      alternatives
#   [ a ]      optional
#   { a }      zero or more
#   ( a )      grouping
#
# Lexical contract:
# - trivia (Unicode whitespace and // line comments) may occur between tokens;
# - <IDENTIFIER> starts with a Unicode letter or "_" and continues with Unicode
#   alphanumerics, "_", or "'"; it excludes every alphabetic literal keyword
#   appearing in this grammar;
# - <DECIMAL_INTEGER> is one or more ASCII decimal digits;
# - keyword literals and <UINT_TYPE> take lexical priority over <IDENTIFIER>;
# - <UINT_TYPE> is "U" followed by one or more ASCII decimal digits; supported
#   widths are checked semantically, not by the grammar;
# - <STRING_LITERAL> is a double-quoted UTF-8 string with escapes for \", \\,
#   \n, \r, and \t; other escapes are rejected.
#
# Separators:
# - commas separate parameter/argument/field lists;
# - semicolons terminate static declaration/configuration items;
# - ordinary term statements retain the Phase 0 semicolon-free surface.
#
# Effects:
# - effect labels are qualified names optionally applied to term arguments;
# - effect sets are explicit brace-delimited sets of effect labels;
# - generic effect-set parameters have kind Effects and may be bounded with
#   an effects ... within ... requirement;
# - effect meaning, subject identity, subeffecting, and authority requirements
#   are semantic checks, not parser responsibilities.
#
# Structural modes:
# - every inhabited value type has a checked unrestricted/affine/linear mode;
# - ordinary term bindings inherit the mode of their type; there is no
#   binding-local structural-mode annotation;
# - ordinary records/sums derive mode from owned contents when mode is omitted;
# - an explicit record/sum mode may only strengthen that derived minimum;
# - capability declarations state mode explicitly because authority and
#   structural copy/drop discipline are orthogonal semantic choices;
# - parsing a mode never proves that the declaration satisfies these rules.
#
# Static reasoning surface:
# - refinement types use { x : T | P } and bind x only in P;
# - non-definitional equality transport is explicit as
#     transport value to TargetType using equality_evidence;
# - finite-collection membership and disjointness are native infix proposition
#   forms using "in" and "disjoint" rather than being encoded as opaque claims;
# - parsing these forms never proves the proposition, validates evidence, or
#   establishes collection/refinement sorts; those remain checker obligations.
#
# Callable outcomes:
# - outcomes names the public outcome/failure set;
# - outcome T { ... } supplies branch-sensitive post-state/callee facts for T;
# - replace callee transitions name the exact successor callable contract and,
#   when required, an explicit successor state expression.
#
# A source parser must consume the entire source file.

source_file = [ module_decl ], { import_decl }, { top_level_decl } ;

module_decl = "module", qualified_name, ";" ;
import_decl = "import", qualified_name, [ "{", identifier_list, "}" ], ";" ;

top_level_decl = { attribute }, declaration ;
attribute = "@", identifier, "(", string_literal, ")" ;

declaration =
    record_decl
  | data_decl
  | type_alias_decl
  | claim_decl
  | callable_contract_decl
  | function_decl
  | provider_contract_decl
  | provider_implementation_decl
  | opaque_provider_implementation_decl
  | protocol_decl
  | capability_decl
  | boundary_decl
  | architecture_decl
  | component_decl
  | program_decl
  ;

qualified_name = identifier, { ".", identifier } ;
identifier_list = identifier, { ",", identifier } ;
identifier = <IDENTIFIER> ;
integer_literal = <DECIMAL_INTEGER> ;
uint_type = <UINT_TYPE> ;
string_literal = <STRING_LITERAL> ;
structural_mode = "unrestricted" | "affine" | "linear" ;

generic_params = "[", generic_param, { ",", generic_param }, "]" ;
generic_param = identifier, ":", generic_kind ;
generic_kind =
    "Type"
  | "Nat"
  | "Session"
  | "Message"
  | "Effects"
  | "provider", type_expression
  | "callable", type_expression
  | "boundary", type_expression
  | "architecture", type_expression
  ;

generic_requirements = "requires", "{", { generic_requirement }, "}" ;
generic_requirement =
    "structural", identifier, ":", identifier, ";"
  | "proposition", proposition, ";"
  | "provider", identifier, ":", type_expression, ";"
  | "callable", identifier, ":", type_expression, ";"
  | "boundary", identifier, ":", type_expression, ";"
  | "architecture", identifier, ":", type_expression, ";"
  | "effects", identifier, "within", effect_set_expression, ";"
  ;

term_params = "(", [ term_param, { ",", term_param } ], ")" ;
term_param = identifier, ":", type_expression ;

type_expression =
    "Unit"
  | "Bool"
  | uint_type
  | "Bytes", "[", expression, "]"
  | "Frame", "[", qualified_name, "]"
  | "Proof", "[", proposition, "]"
  | "Validated", "[", qualified_name, ",", expression, ",", expression, "]"
  | refinement_type
  | named_type
  ;

refinement_type =
  "{", identifier, ":", type_expression, "|", proposition, "}" ;

named_type = qualified_name, [ static_arguments ] ;
static_arguments =
  "[", [ static_argument, { ",", static_argument } ], "]" ;
static_argument =
    expression
  | effect_set_literal
  ;
term_arguments = "(", [ expression, { ",", expression } ], ")" ;

record_decl =
  "record", identifier, [ generic_params ], [ "mode", structural_mode ],
  [ generic_requirements ],
  "{", [ field_decl, { ",", field_decl }, [ "," ] ], "}" ;
field_decl = identifier, ":", type_expression ;

data_decl =
  "data", identifier, [ generic_params ], [ "mode", structural_mode ],
  [ generic_requirements ],
  "=", variant_decl, { "|", variant_decl }, ";" ;
variant_decl = identifier, [ variant_payload ] ;
variant_payload =
    "{", [ field_decl, { ",", field_decl }, [ "," ] ], "}"
  | "(", [ type_expression, { ",", type_expression } ], ")"
  ;

type_alias_decl =
  "type", identifier, [ generic_params ], [ generic_requirements ],
  "=", type_expression, ";" ;

claim_decl =
  "claim", identifier, [ generic_params ], [ generic_requirements ],
  [ term_params ], [ "=", proposition ], ";" ;

callable_contract_decl =
  "callable", identifier, [ generic_params ], [ generic_requirements ],
  term_params, "->", type_expression, callable_contract_block ;

callable_contract_block = "{", { callable_clause }, "}" ;
callable_clause =
    "requires", proposition, ";"
  | "consumes", name_set, ";"
  | "borrows", name_set, ";"
  | "authority", type_set, ";"
  | "effects", effect_set_expression, ";"
  | "outcomes", type_set, ";"
  | outcome_residue
  | "ensures", proposition, ";"
  | "assumes", proposition, ";"
  | "cost", expression, ";"
  | "callee", callee_transition, ";"
  ;

outcome_residue =
  "outcome", type_expression, "{", { outcome_residue_clause }, "}" ;
outcome_residue_clause =
    "state", "(", [ state_slot, { ",", state_slot } ], ")", ";"
  | "callee", callee_transition, ";"
  | "ensures", proposition, ";"
  ;

callee_transition =
    "preserve"
  | "consume"
  | "replace", "with", static_reference, [ "state", expression ]
  ;
name_set = "{", [ qualified_name, { ",", qualified_name } ], "}" ;
type_set = "{", [ type_expression, { ",", type_expression } ], "}" ;

effect_set_expression =
    effect_set_literal
  | qualified_name
  ;
effect_set_literal =
  "{", [ effect_expression, { ",", effect_expression } ], "}" ;
effect_expression =
  qualified_name, [ term_arguments ] ;

function_decl =
  [ "recursive" ], "fn", identifier,
  [ generic_params ], [ generic_requirements ],
  term_params, [ "->", type_expression ],
  "satisfies", type_expression, block ;

provider_contract_decl =
  "provider", identifier, [ generic_params ], [ generic_requirements ],
  "{", { provider_contract_item }, "}" ;

provider_contract_item =
    "operation", identifier, ":", type_expression, ";"
  | "law", identifier, ":", proposition, ";"
  | "lifecycle", identifier, ":", proposition, ";"
  ;

provider_implementation_decl =
  "provider", "implementation", identifier,
  [ generic_params ], [ generic_requirements ],
  "satisfies", type_expression,
  "{", { provider_implementation_item }, "}" ;

provider_implementation_item =
    "operation", identifier, "satisfies", type_expression, block
  | "law", identifier, "=", proposition, ";"
  | "lifecycle", identifier, "=", proposition, ";"
  ;

opaque_provider_implementation_decl =
  "opaque", "provider", "implementation", identifier,
  [ generic_params ], [ generic_requirements ],
  "satisfies", type_expression, ";" ;

protocol_decl =
  "protocol", identifier, [ generic_params ], [ generic_requirements ],
  "{", role_session_decl, role_session_decl, "}" ;

role_session_decl = "role", identifier, "=", session_expression, ";" ;

session_expression =
    "send", "(", term_param, ")", [ "using", qualified_name ],
      [ "when", proposition ], "then", session_expression
  | "receive", "(", term_param, ")", [ "using", qualified_name ],
      [ "when", proposition ], "then", session_expression
  | "select", "{", session_branch, { "|", session_branch }, "}"
  | "offer", "{", session_branch, { "|", session_branch }, "}"
  | "end", identifier
  | "recursive", identifier, "=", session_expression
  | "continue", identifier
  ;

session_branch =
  identifier, [ "(", [ term_param, { ",", term_param } ], ")" ],
  [ "using", qualified_name ], [ "when", proposition ],
  "=>", session_expression ;

capability_decl =
  "capability", identifier, [ generic_params ], "mode", structural_mode,
  [ generic_requirements ],
  "{", { capability_item }, "}" ;

capability_item =
    "permits", qualified_name, ";"
  | "requires", proposition, ";"
  | "law", identifier, ":", proposition, ";"
  ;

boundary_decl =
  "boundary", identifier, [ generic_params ], [ generic_requirements ],
  ":", type_expression, "{", { boundary_item }, "}" ;

boundary_item =
    "receive", "using", qualified_name, ";"
  | "send", "using", qualified_name, ";"
  | "correspondence", proposition, ";"
  | "canonical", ";"
  | "failure", type_expression, ";"
  | "law", identifier, ":", proposition, ";"
  ;

architecture_decl =
  "architecture", identifier, [ generic_params ], [ generic_requirements ],
  "{", { architecture_item }, "}" ;

architecture_item =
    "instance", identifier, "=", static_reference, ";"
  | "ref", identifier, "=", qualified_name, ";"
  | "protocol", identifier, "=", static_reference, ";"
  | "role", qualified_name, "=", qualified_name, ";"
  | "bind", qualified_name, "=", qualified_name, ";"
  | "authority", identifier, ":", type_expression,
      "originates", "at", qualified_name, ";"
  | "grant", qualified_name, "=", expression, ";"
  | "boundary", qualified_name, "=", qualified_name, ";"
  | "entry", identifier, ":", type_expression, ";"
  | "assume", proposition, "within", qualified_name, ";"
  | "export", "obligation", qualified_name, "to", qualified_name, ";"
  | "observable", qualified_name, ";"
  | "constraint", proposition, ";"
  ;

static_reference = qualified_name, [ static_arguments ] ;

component_decl =
  "component", identifier, [ generic_params ], [ generic_requirements ],
  [ term_params ], [ "provides", type_expression ], block ;

program_decl =
  "program", identifier, "=", "instantiate", static_reference,
  [ program_block ], ";" ;

program_block = "{", { program_item }, "}" ;
program_item =
    "entry", identifier, ":", type_expression, ";"
  | "assume", proposition, "within", qualified_name, ";"
  | "export", "obligation", qualified_name, "to", qualified_name, ";"
  | "observable", qualified_name, ";"
  ;

block = "{", { statement }, "}" ;
statement =
    "let", pattern, "=", expression
  | "return", expression
  | expression
  ;

pattern =
    identifier
  | tuple_pattern
  | record_pattern
  ;

tuple_pattern = "(", pattern, ",", pattern, { ",", pattern }, ")" ;
record_pattern =
  qualified_name, "{", field_pattern, { ",", field_pattern }, [ "," ], "}" ;
field_pattern = identifier, [ "=", pattern ] ;

expression = additive_expression, [ "or", fallback ] ;
fallback = "fail", qualified_name | "reject", additive_expression ;

additive_expression =
  multiplicative_expression,
  { ( "+" | "-" ), multiplicative_expression } ;

multiplicative_expression =
  postfix_expression, { "*", postfix_expression } ;

postfix_expression =
  primary_expression, { ".", identifier } ;

primary_expression =
    construct_expression
  | borrow_expression
  | if_expression
  | match_expression
  | decide_expression
  | closure_expression
  | loop_expression
  | continue_expression
  | break_expression
  | receive_frame_expression
  | receive_exact_expression
  | receive_expression
  | recognize_expression
  | validate_expression
  | send_exact_expression
  | send_expression
  | select_expression
  | offer_expression
  | commit_receive_expression
  | fail_expression
  | close_expression
  | release_expression
  | transport_expression
  | accept_expression
  | prove_expression
  | parenthesized_expression
  | "true"
  | "false"
  | "unit"
  | integer_literal
  | name_expression
  ;

name_expression =
  qualified_name, [ static_arguments ], [ term_arguments ] ;

construct_expression =
  "construct", qualified_name,
  "{", [ field_assignment, { ",", field_assignment }, [ "," ] ], "}" ;
field_assignment = identifier, "=", expression ;

borrow_expression =
  "borrow", additive_expression, "as", identifier, block ;

join_clause =
  "join", "state", "(", [ state_slot, { ",", state_slot } ], ")" ;
state_slot = identifier, ":", type_expression ;

if_expression =
  "if", expression, [ join_clause ], block, [ "else", block ] ;

match_expression =
  "match", expression, [ join_clause ],
  "{", match_arm, { match_arm }, "}" ;

match_arm =
  case_pattern, "=>", ( block | statement ) ;

case_pattern =
  qualified_name,
  [ "(", [ identifier, { ",", identifier } ], ")"
    | "{", [ field_binder, { ",", field_binder }, [ "," ] ], "}" ] ;
field_binder = identifier, [ "as", identifier ] ;

decide_expression =
  "decide", additive_expression,
  "{", match_arm, { match_arm }, "}" ;

closure_expression =
  "closure", term_params, "satisfies", type_expression,
  [ "captures", "(", [ identifier_list ], ")" ], block ;

loop_expression =
  "loop",
  [ "state", "(", [ state_binding, { ",", state_binding } ], ")" ],
  [ "invariant", proposition ],
  block ;
state_binding = identifier, "=", expression ;

continue_expression =
  "continue", [ "(", [ expression, { ",", expression } ], ")" ] ;

break_expression =
  "break", [ "(", [ expression, { ",", expression } ], ")" ] ;

receive_frame_expression =
  "receive_frame", "(", expression, ")" ;

receive_exact_expression =
  "receive_exact", additive_expression, "on", additive_expression,
  [ "using", additive_expression ] ;

receive_expression =
  "receive", type_expression, "on", additive_expression ;

recognize_expression =
  "recognize", qualified_name, "from", additive_expression ;

validate_expression =
  "validate", qualified_name,
  [ "at", additive_expression ], "on", additive_expression ;

send_exact_expression =
  "send_exact", additive_expression, "on", additive_expression ;

send_expression =
  "send", additive_expression, "on", additive_expression ;

select_expression =
  "select", branch_value, "on", additive_expression,
  [ "using", additive_expression ] ;

offer_expression =
  "offer", additive_expression,
  "{", match_arm, { match_arm }, "}" ;

branch_value =
  qualified_name, [ term_arguments ] ;

commit_receive_expression =
  "commit_receive", additive_expression, "using", additive_expression ;

fail_expression =
  "fail", failure_target, "on", additive_expression ;

failure_target =
  qualified_name, [ term_arguments ] ;

close_expression = "close", additive_expression ;
release_expression = "release", additive_expression ;

transport_expression =
  "transport", additive_expression, "to", type_expression,
  "using", additive_expression ;

accept_expression =
  "accept", additive_expression, "as", type_expression ;

prove_expression = "prove", proposition ;

parenthesized_expression =
  "(", [ expression, { ",", expression } ], ")" ;

proposition = proposition_or ;
proposition_or =
  proposition_and, { "or", proposition_and } ;
proposition_and =
  proposition_not, { "and", proposition_not } ;
proposition_not =
  "not", proposition_not | proposition_atom ;

proposition_atom =
    relation_proposition
  | "(", proposition, ")"
  | "true"
  | "false"
  | claim_application
  ;

relation_proposition =
  additive_expression, relation_operator, additive_expression ;

relation_operator =
    "=="
  | "!="
  | "<="
  | ">="
  | "<"
  | ">"
  | "in"
  | "disjoint"
  ;

claim_application =
  qualified_name, "(", [ expression, { ",", expression } ], ")" ;
