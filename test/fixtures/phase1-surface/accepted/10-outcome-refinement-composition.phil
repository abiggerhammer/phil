module corpus.outcome_refinement;

callable Decode[n : Nat](input : Blob) -> DecodeResult {
  outcomes { success DecodeOk, negative DecodeError };
  outcome success DecodeOk {
    state (payload : {b : Bytes[n] | n > 0});
    ensures true;
  }
  outcome negative DecodeError {
    state ();
    ensures true;
  }
  callee preserve;
}
