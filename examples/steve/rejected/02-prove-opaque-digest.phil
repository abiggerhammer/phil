// reject: DigestMatches is opaque; generic `prove` cannot manufacture it.
//
// This witness is intentionally minimal. The stable byte-object identity is an
// architecture-supplied binding so the test exercises only the generic opaque-
// proof rule; it does not depend on any Steve-specific field projection or
// provider primitive.
component BadProveDigest(
    id : ContentId[SHA256],
    object
) provides Unit {
    let digestEvidence = prove DigestMatches(id, object)
    return unit
}
