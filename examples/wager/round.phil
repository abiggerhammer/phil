// One player's side of a commit-reveal wager round in The Line.
//
// Each round, both players secretly choose a pull from 0 to 30. In wager
// mode the referee is a Solana program, outside Phil. Each player talks to it
// in its own session: commit a hash, wait until both sides have committed,
// reveal the pull and the nonce, then learn how the round went.
//
// The commit is (match, round, hash). The hash is
//   SHA-256(series || match || round || side || pull || nonce)
// with a 32-byte nonce, since a pull has only 31 values to guess from.
// The reveal is (pull, nonce).

// A move, held by the player until it is revealed. The 32-byte nonce makes
// the record linear, and declaring it any weaker is refused. That is a
// record-mode obligation only: the protocol below sends tuples, not Move, and
// WagerPlayer returns unit, so nothing here checks that a nonce is used once
// or that losing it forfeits the match.
record Move mode linear {
  pull : {p : U8 | p <= 30},
  nonce : Bytes[32]
}

// BothCommitted carries nothing: before revealing, a player learns that the
// other side has committed, never what. Round results are labels too: the
// node moved toward this player, away from it, or held.
protocol WagerRound {
  role Player = recursive Round =
    send (commit : (U8, U8, Bytes[32])) then offer {
      BothCommitted =>
        send (reveal : (U8, Bytes[32])) then offer {
          TowardMe => continue Round |
          AwayFromMe => continue Round |
          Held => continue Round |
          MatchWon => end Won |
          MatchLost => end Lost |
          MatchDrawn => end Drawn |
          OpponentForfeit => end Won
        } |
      OpponentRetired => end Won
    };
  role Program = recursive Round =
    receive (commit : (U8, U8, Bytes[32])) then select {
      BothCommitted =>
        receive (reveal : (U8, Bytes[32])) then select {
          TowardMe => continue Round |
          AwayFromMe => continue Round |
          Held => continue Round |
          MatchWon => end Won |
          MatchLost => end Lost |
          MatchDrawn => end Drawn |
          OpponentForfeit => end Won
        } |
      OpponentRetired => end Won
    };
}

component WagerPlayer provides Unit {
  return unit;
}

// The player is a Phil process; the referee is the line-wager program on
// Solana, so its role is external.
architecture PracticeWager {
  instance player = WagerPlayer;
  process player_run = player;
  protocol round = WagerRound;
  role round.Player = player;
  role round.Program = external;
}

program main = instantiate PracticeWager;
