cabal-version:      3.0
name:               phil-core
version:            0.0.1.0
synopsis:           Bootstrap executable kernel for the Phil Core checker
build-type:          Simple

data-files:
    examples/upload/*.phil
    examples/rejected/*.phil

common common-settings
  default-language: GHC2021
  ghc-options:
      -Wall
      -Wcompat
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wredundant-constraints

library
  import:             common-settings
  hs-source-dirs:     src
  exposed-modules:
      Phil.Core.Syntax
      Phil.Core.Context
      Phil.Core.Checker
      Phil.Core.Session
      Phil.Core.Process
      Phil.Core.Recognition
      Phil.Core.SortCheck
      Phil.Core.Static
      Phil.Core.Refinement
      Phil.Core.Focusing
      Phil.Core.Decision
      Phil.Core.Discharge
      Phil.Core.Value
      Phil.Surface.Syntax
      Phil.Surface.Parser
      Phil.Surface.Elaborate
  build-depends:
      base >=4.17 && <5,
      containers >=0.6 && <0.8,
      megaparsec >=9.6 && <10,
      text >=2.0 && <2.2

executable phil-core
  import:             common-settings
  hs-source-dirs:     app
  main-is:            Main.hs
  build-depends:
      base >=4.17 && <5,
      phil-core,
      text >=2.0 && <2.2

test-suite phil-core-tests
  import:             common-settings
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  build-depends:
      base >=4.17 && <5,
      containers >=0.6 && <0.8,
      phil-core,
      text >=2.0 && <2.2

