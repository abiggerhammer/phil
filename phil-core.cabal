cabal-version:      3.0
name:               phil-core
version:            0.0.1.0
synopsis:           Bootstrap executable kernel for the Phil Core checker
build-type:          Simple

data-files:
    examples/upload/*.phil
    examples/rejected/*.phil
    examples/run/*.phil

common common-settings
  default-language: GHC2021
  ghc-options:
      -Wall
      -Wcompat
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wredundant-constraints

library
  import:             common-settings
  hs-source-dirs:     src
  exposed-modules:
      Phil.Core.Syntax
      Phil.Core.Scalar
      Phil.Core.Context
      Phil.Core.Checker
      Phil.Core.Session
      Phil.Core.Process
      Phil.Core.Recognition
      Phil.Core.SortCheck
      Phil.Core.Static
      Phil.Core.Refinement
      Phil.Core.Focusing
      Phil.Core.Decision
      Phil.Core.Discharge
      Phil.Core.Value
      Phil.Surface.Syntax
      Phil.Surface.Parser
      Phil.Surface.Elaborate
      Phil.Surface.Check
      Phil.Surface.Phase0
      Phil.Assurance
      Phil.Systems
      Phil.LLVM
      Phil.Compiler
  other-modules:
      Phil.Surface.Check.Types
      Phil.Surface.Check.Support
      Phil.Surface.Check.Preflight
      Phil.Surface.Check.Engine
      Phil.Assurance.Types
      Phil.Assurance.Handoff
      Phil.Assurance.Verify
      Phil.Assurance.Phase0
      Phil.Assurance.Rocq
      Phil.Assurance.RocqRecognizedRecord
      Phil.Assurance.RocqExactReceive
      Phil.Assurance.RocqDigestValidation
      Phil.Assurance.RocqStorage
      Phil.Systems.IR
      Phil.Systems.Verify
      Phil.Systems.Phase0
      Phil.Systems.Dataflow
      Phil.Systems.FieldProjection
      Phil.Systems.RecognizedRecord
      Phil.Systems.DigestValidation
      Phil.Systems.Storage
      Phil.Systems.AcceptedResponse
      Phil.Systems.RejectedResponse
      Phil.Systems.SessionChoice
      Phil.Systems.PayloadCancelChoice
      Phil.Systems.LocalRuntimeChoice
      Phil.Systems.VersionSessionChoice
      Phil.Systems.VersionChoiceOperands
      Phil.Systems.BeginPolicySessionChoice
      Phil.LLVM.IR
      Phil.LLVM.Lower
      Phil.LLVM.Verify
      Phil.LLVM.Phase0
      Phil.LLVM.RecognizedRecord
      Phil.LLVM.RecognizedRecordCertification
      Phil.LLVM.RecognizedRecordProofCertification
      Phil.LLVM.ExactReceive
      Phil.LLVM.ExactReceiveCertification
      Phil.LLVM.ExactReceiveProofCertification
      Phil.LLVM.DigestValidation
      Phil.LLVM.DigestValidationCertification
      Phil.LLVM.DigestValidationProofCertification
      Phil.LLVM.Storage
      Phil.LLVM.StorageCertification
      Phil.LLVM.StorageProofCertification
      Phil.LLVM.AcceptedResponse
      Phil.LLVM.AcceptedResponseCertification
      Phil.LLVM.RejectedResponse
      Phil.LLVM.RejectedResponseCertification
      Phil.LLVM.SessionOffer
      Phil.LLVM.SessionOfferCertification
      Phil.LLVM.PayloadCancelChoice
      Phil.LLVM.PayloadCancelChoiceCertification
      Phil.LLVM.VersionSessionChoice
      Phil.LLVM.VersionSessionChoiceCertification
      Phil.LLVM.BeginPolicyChoice
      Phil.LLVM.BeginPolicyChoiceCertification
  build-depends:
      base >=4.17 && <5,
      bytestring >=0.11 && <0.13,
      containers >=0.6 && <0.8,
      cryptohash-sha256 >=0.11 && <0.12,
      megaparsec >=9.6 && <10,
      text >=2.0 && <2.2

executable phil-core
  import:             common-settings
  hs-source-dirs:     app
  main-is:            Main.hs
  build-depends:
      base >=4.17 && <5,
      phil-core,
      text >=2.0 && <2.2

